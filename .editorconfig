# Stop the search here.  Without this, EditorConfig keeps looking in every parent directory, so
# what applies to this repository would depend on what sits above the clone.
root = true

[*.cs]

# Using directives:  sorted alphabetically and split into groups by root namespace, one blank line
# between groups, with System in its alphabetical place rather than hoisted first.  Visual Studio's
# "Remove and Sort Usings" reads these directly; dotnet format does not sort usings at all.  Setting
# them here rather than in per-machine options is what keeps the ordering consistent across files.
dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = false

# CS8424: The EnumeratorCancellationAttribute will have no effect. The attribute is only effective on a parameter of type CancellationToken in an async-iterator method returning IAsyncEnumerable
dotnet_diagnostic.CS8424.severity = silent

# OPENAI001: Type is for evaluation purposes only and is subject to change or removal in future updates. Suppress this diagnostic to proceed.
dotnet_diagnostic.OPENAI001.severity = none

# CA1309: Use ordinal string comparison. Enabled (off by default) to enforce culture-independent
# comparison of non-linguistic strings (identifiers, keys). Promoted to error via TreatWarningsAsErrors.
dotnet_diagnostic.CA1309.severity = warning
